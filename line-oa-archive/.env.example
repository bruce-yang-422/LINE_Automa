# 控制台啟動器會讀取本資料夾的 .env；直接執行 app.py 仍需設定環境變數。
# 相對路徑以 app.py 所在資料夾為基準；SQLite 不需要帳號或密碼。
DATABASE_PATH=data/line_archive.db
# LINE 頻道密鑰用來驗證 Webhook 的來源，仍需設定。
LINE_CHANNEL_SECRET=replace_with_messaging_api_channel_secret
# 主動發送圖片：LINE Developers > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
PUBLIC_BASE_URL=https://reports.stack-base.com
# 管理頁預設圖片；多位收件者與訂閱由管理頁設定，不在 .env 填 ID。
WEATHER_IMAGE_PATH=D:\Tools\ai_weather_report\output\weather_report.png
# 遠端管理：四項完整填入並重啟才會啟用；未設定時只允許本機管理。
ADMIN_PUBLIC_HOST=line-admin.stack-base.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# 初次建立管理員；後續新增／停用帳號請使用網站「帳號與設定」。
ADMIN_ALLOWED_EMAILS=

# Personal weather module; employees only see it when explicitly assigned as owner.
WEATHER_MODULE_ENABLED=true
WEATHER_OWNER_EMAIL=
